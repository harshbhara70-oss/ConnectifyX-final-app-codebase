# ==========================================
# CONNECTIFYX - Environment Variables Template
# ==========================================
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your real .env file to GitHub!

# MongoDB Atlas Connection URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/connectifyx?retryWrites=true&w=majority

# Web Frontend Authentication (Clerk)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here

# Google Gemini AI Integration
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Super Admin Portal Credentials
ADMIN_EMAIL=admin@connectifyx.com
ADMIN_PASSWORD=your_secure_admin_password_here
JWT_ADMIN_SECRET=your_super_secret_admin_jwt_key_2026

# Backend Server Port
PORT=5000
